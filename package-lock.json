{
  "name": "quv4",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "quv4",
      "version": "0.0.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@qu/ap-core": {
      "resolved": "packages/ap-core",
      "link": true
    },
    "node_modules/@qu/as2": {
      "resolved": "packages/as2",
      "link": true
    },
    "packages/ap-core": {
      "name": "@qu/ap-core",
      "version": "0.0.0",
      "dependencies": {
        "@qu/as2": "*"
      }
    },
    "packages/as2": {
      "name": "@qu/as2",
      "version": "0.0.0"
    }
  }
}
