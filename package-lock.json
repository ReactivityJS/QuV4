{
  "name": "quv4",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "quv4",
      "version": "0.0.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@qu/ap-core": {
      "resolved": "packages/ap-core",
      "link": true
    },
    "node_modules/@qu/ap-store": {
      "resolved": "packages/ap-store",
      "link": true
    },
    "node_modules/@qu/as2": {
      "resolved": "packages/as2",
      "link": true
    },
    "node_modules/@qu/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@qu/local-vault": {
      "resolved": "packages/local-vault",
      "link": true
    },
    "node_modules/@qu/reactive": {
      "resolved": "packages/reactive",
      "link": true
    },
    "node_modules/@qu/runtime": {
      "resolved": "packages/runtime",
      "link": true
    },
    "packages/ap-core": {
      "name": "@qu/ap-core",
      "version": "0.0.0",
      "dependencies": {
        "@qu/as2": "*"
      }
    },
    "packages/ap-store": {
      "name": "@qu/ap-store",
      "version": "0.0.0",
      "dependencies": {
        "@qu/as2": "*",
        "@qu/core": "*"
      },
      "devDependencies": {
        "@qu/runtime": "*"
      }
    },
    "packages/as2": {
      "name": "@qu/as2",
      "version": "0.0.0"
    },
    "packages/core": {
      "name": "@qu/core",
      "version": "0.0.0"
    },
    "packages/local-vault": {
      "name": "@qu/local-vault",
      "version": "0.0.0"
    },
    "packages/reactive": {
      "name": "@qu/reactive",
      "version": "0.0.0",
      "devDependencies": {
        "@qu/ap-store": "*",
        "@qu/core": "*"
      }
    },
    "packages/runtime": {
      "name": "@qu/runtime",
      "version": "0.0.0"
    }
  }
}
